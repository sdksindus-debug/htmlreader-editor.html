<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monochrome Mainframe Runner</title>
    <!-- Importing a clean, early-computing pixel monospace font -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Courier Prime', Courier, monospace;
            height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: #ffffff;
            color: #000000;
            overflow: hidden;
        }
        /* Classic dot matrix grid overlay texture */
        body::before {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(0, 0, 0, 0.03) 50%, rgba(255, 255, 255, 0) 50%);
            z-index: 10;
            background-size: 100% 4px;
            pointer-events: none;
        }
        header {
            background-color: #ffffff;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #000000;
        }
        h1 {
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .action-group {
            display: flex;
            gap: 8px;
            align-items: center;
        }
        .btn-retro {
            background-color: #ffffff;
            color: #000000;
            border: 1px solid #000000;
            padding: 6px 14px;
            font-family: 'Courier Prime', Courier, monospace;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.1s ease;
        }
        .btn-retro:hover {
            background-color: #000000;
            color: #ffffff;
        }
        .btn-retro:active {
            background-color: #666666;
            color: #ffffff;
        }
        #file-input {
            display: none;
        }
        .container {
            display: flex;
            flex: 1;
            overflow: hidden;
            padding: 15px;
            gap: 15px;
            background-color: #f0f0f0;
        }
        .panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100%;
            border: 2px solid #000000;
            background-color: #ffffff;
        }
        .panel-title {
            background-color: #e0e0e0;
            padding: 6px 12px;
            font-size: 0.95rem;
            font-weight: 700;
            color: #000000;
            border-bottom: 1px solid #000000;
        }
        textarea {
            flex: 1;
            background-color: #ffffff;
            color: #000000;
            font-family: 'Courier Prime', Courier, monospace;
            font-size: 1.1rem;
            padding: 15px;
            border: none;
            resize: none;
            outline: none;
            line-height: 1.5;
        }
        /* Classic minimalist mechanical scrollbar */
        textarea::-webkit-scrollbar {
            width: 10px;
        }
        textarea::-webkit-scrollbar-track {
            background: #ffffff;
            border-left: 1px solid #000000;
        }
        textarea::-webkit-scrollbar-thumb {
            background: #000000;
        }
        iframe {
            flex: 1;
            background-color: #ffffff;
            border: none;
            height: 100%;
            width: 100%;
        }
    </style>
</head>
<body>

    <header>
        <h1>[ SYSTEM CODE TERMINAL // MODEL-1975 ]</h1>
        <div class="action-group">
            <input type="file" id="file-input" accept=".html,.htm,.txt" onchange="loadFile(event)">
            
            <button class="btn-retro" onclick="triggerFileOpen()">LOAD RECORD</button>
            <button class="btn-retro" onclick="saveFile()">WRITE .HTML</button>
            <button class="btn-retro" onclick="runCode()">EXECUTE</button>
        </div>
    </header>

    <div class="container">
        <!-- Text input buffer -->
        <div class="panel">
            <div class="panel-title">BUFFER_INPUT</div>
            <textarea id="code-input" spellcheck="false" placeholder="READY FOR INPUT..."><!-- Example code -->
<!DOCTYPE html>
<html>
<head>
    <style>
        body { 
            font-family: monospace; 
            padding: 30px; 
            color: #000000;
            background: #ffffff;
        }
        h2 { 
            border-bottom: 2px dashed #000; 
            padding-bottom: 5px; 
        }
        .alert-box {
            border: 1px solid #000;
            padding: 15px;
            margin-top: 20px;
            background: #f9f9f9;
        }
    </style>
</head>
<body>
    <h2>OUTPUT SYSTEM AGENT</h2>
    <p>Verification sequence running under normal parameters.</p>
    <div class="alert-box">
        All modules active.
    </div>
</body>
</html></textarea>
        </div>

        <!-- Render Target Frame -->
        <div class="panel">
            <div class="panel-title">PRINTER_PREVIEW</div>
            <iframe id="output-preview"></iframe>
        </div>
    </div>

    <script>
        function runCode() {
            const code = document.getElementById('code-input').value;
            const previewFrame = document.getElementById('output-preview');
            const innerDoc = previewFrame.contentDocument || previewFrame.contentWindow.document;
            
            innerDoc.open();
            innerDoc.write(code);
            innerDoc.close();
        }

        function triggerFileOpen() {
            document.getElementById('file-input').click();
        }

        function loadFile(event) {
            const file = event.target.files;
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('code-input').value = e.target.result;
                runCode();
            };
            reader.readAsText(file);
        }

        function saveFile() {
            const code = document.getElementById('code-input').value;
            const blob = new Blob([code], { type: 'text/html' });
            const link = document.createElement('a');
            
            link.download = `archive_${Date.now()}.html`;
            link.href = URL.createObjectURL(blob);
            
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        document.getElementById('code-input').addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                runCode();
            }
        });

        window.onload = runCode;
    </script>
</body>
</html>
